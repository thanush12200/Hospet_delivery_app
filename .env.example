# Supabase project — use the ap-south-1 (Mumbai) region.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google sign-in button (optional): OAuth web client id from Google Cloud -> Clients
VITE_GOOGLE_CLIENT_ID=

# Google Maps (optional): browser key with referrer + API restrictions, see README "Google Maps".
# Unset = OpenStreetMap map and Photon place search.
VITE_GOOGLE_MAPS_KEY=

# Ola Maps (optional, no card needed): API key from cloud.olakrutrim.com, see README "Ola Maps".
# Used when no Google key is set. Unset = OpenStreetMap map and Photon search.
VITE_OLA_MAPS_KEY=
